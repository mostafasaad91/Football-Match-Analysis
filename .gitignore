# ══════════════════════════════════════════════════════
#  WhoScored Post-Match Analyzer — .gitignore
# ══════════════════════════════════════════════════════

# ── Output files ─────────────────────────────────────
output/
*.png
*.pdf
*.csv
!sample_data/
!sample_data/**/*.csv
# The frozen reference the golden test compares against. Without this the
# blanket *.csv rule above keeps it out of the repository, and the test skips
# itself on a fresh clone instead of failing — the quietest way to lose a
# regression guard.
!tests/golden/
!tests/golden/**/*.csv

# ── Claude Code session data ─────────────────────────
.claude/

# ── Python ───────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
*.egg
dist/
build/
.eggs/

# ── Virtual environments ─────────────────────────────
venv/
.venv/
env/
.env/

# ── IDE / Editor ─────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.project
.classpath
.settings/
*.sublime-project
*.sublime-workspace

# ── OS generated files ───────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# ── Jupyter Notebook ────────────────────────────────
.ipynb_checkpoints/
*.ipynb

# ── Browser / Selenium ──────────────────────────────
chromedriver
chromedriver.exe
*.crx
selenium_stealth/

# ── Logs ─────────────────────────────────────────────
*.log
logs/

# ── Secrets / Environment ────────────────────────────
.env
.env.local
*.key
*.pem

# ── Temporary files ──────────────────────────────────
tmp/
temp/
*.tmp
*.bak

# ── Coverage reports ─────────────────────────────────
htmlcov/
.coverage
.coverage.*
coverage.xml

# Local deliverables — not published to the repository
docs/

# Cached club crests. Fetched per fixture and rendered on the posters with
# attribution; the crests themselves are club trademarks and are not ours to
# redistribute, so the cache stays out of the repository.
assets/crests/

# A roster is the user's own opinion about who plays for whom, not project data.
squads.json
